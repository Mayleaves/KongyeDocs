<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="settings.json" />
        <exclude domain="file" path="settings.json.bak" />
        <exclude domain="file" path="settings.json.tmp" />
        <exclude domain="file" path=".transaction/" />
        <exclude domain="file" path="recovery/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="settings.json" />
        <exclude domain="file" path="settings.json.bak" />
        <exclude domain="file" path="settings.json.tmp" />
        <exclude domain="file" path=".transaction/" />
        <exclude domain="file" path="recovery/" />
    </device-transfer>
</data-extraction-rules>
