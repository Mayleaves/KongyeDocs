<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebDAV 备份与 GitHub 更新 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 密码填充：只有同一签名（本机 debug.keystore）的空叶键盘 / 悬浮球能拿到这个权限，
         见 docs/密码填充-接口与任务.md。空叶文档自己也申请，以便核对同进程调用。 -->
    <permission
        android:name="com.kongye.permission.VAULT"
        android:protectionLevel="signature"
        android:label="读取空叶文档密码空间" />
    <uses-permission android:name="com.kongye.permission.VAULT" />
    <!-- 解锁密码空间对外读取时用指纹验证 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 3.3：关联 App 时读取它的签名证书，只在证书相同时推荐（防同包名仿冒 App）。自用，不上架商店 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 密码空间：显示「已用于」的 App 名称、给条目选择适用的 App、看空叶键盘 / 悬浮球是否已安装 -->
    <queries>
        <package android:name="com.kongye.keyboard" />
        <package android:name="com.kongye.keyboard.debug" />
        <package android:name="com.kongye.floatball" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic：允许 http:// 地址的 WebDAV（家里的 NAS 常用 http） -->
    <application
        android:name=".KongyeApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Kongye">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 其他应用“分享到空叶文档”时新建一篇笔记 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 密码空间对外接口：content://<applicationId>.vault，只用 call() -->
        <provider
            android:name=".vault.VaultProvider"
            android:authorities="${applicationId}.vault"
            android:exported="true"
            android:permission="com.kongye.permission.VAULT" />

        <!-- 解锁密码空间（指纹 / 锁屏密码）：透明、不进最近任务，关掉后回到原来的 App -->
        <activity
            android:name=".vault.VaultUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|locale|layoutDirection|fontScale" />

        <!-- 系统自动填充服务（3.3）：在系统设置里选空叶文档后，登录 / 注册页弹出下拉框或键盘工具栏候选 -->
        <service
            android:name=".autofill.KongyeAutofillService"
            android:exported="true"
            android:label="空叶文档"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- 自动填充弹出的界面：解锁后交出账号密码、更多密码、生成强密码、保存确认。透明、不进最近任务 -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|locale|layoutDirection|fontScale" />

        <service android:name=".data.BackupJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
